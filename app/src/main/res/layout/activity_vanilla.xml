<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <Button android:id="@+id/btnLoadOrig" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="تحميل فانيلا الأصلي" />
        <TextView android:id="@+id/txtOrig" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="6dp" />
        <Button android:id="@+id/btnLoadTgt" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="تحميل فانيلا التارجت" />
        <TextView android:id="@+id/txtTgt" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="6dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="طول الأيدي (بايت):" android:labelFor="@+id/edIdLen" />
        <EditText android:id="@+id/edIdLen" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="number" android:hint="16" />

        <Button android:id="@+id/btnScan" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="فحص الأيديهات" />
        <TextView android:id="@+id/txtScan" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="6dp" android:textSize="15sp"
            android:accessibilityLiveRegion="polite" />

        <CheckBox android:id="@+id/chkRepair" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="إصلاح SPHE CRC بعد نسخ الأيدي" android:checked="true" />
        <CheckBox android:id="@+id/chkBackup" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="عمل نسخة احتياطية" android:checked="true" />
        <CheckBox android:id="@+id/chkVerify" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="التحقق من الملف بعد الحفظ" android:checked="true" />

        <Button android:id="@+id/btnCopyId" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="نسخ الأيدي" />
        <Button android:id="@+id/btnCopyBlock" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="نسخ بلوك SPHE الـ 256 بايت" />
        <Button android:id="@+id/btnRepairOnly" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="إصلاح CRC فقط" />

        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:textSize="16sp"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
